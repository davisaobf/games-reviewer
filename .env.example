# ==============================================================================
# Games Reviewer - Steam AI Assistant Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for Antigravity Agent LLM)
# Get free key at: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=

# Steam Web API Key (Optional but recommended for full library stats)
# Get key at: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Target Steam User ID or Vanity Name (Default: davii123)
STEAM_USER_ID=davii123

# IsThereAnyDeal (ITAD) API Key (Used to track historical low prices in BRL)
# Get free key at: https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# Discord Webhook URL (For push notifications when game hits historical low)
# Create in Discord: Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# Autonomous Periodic Trigger Configuration
# Interval in seconds: 259200 = 3 days (72 hours)
CHECK_INTERVAL_SECONDS=259200

# Regional Price Settings
CURRENCY=BRL
COUNTRY=BR
